@dataclass(frozen=True)
class Session:
    proc: Proc
    cfg: str
    data: dict

    @property
    def state(self) -> str:
        status = self.data.get("status")
        return status if status in ("busy", "idle") else "unknown"

    @property
    def session_id(self) -> str:
        return str(self.data.get("sessionId") or "")


def config_dir(proc: str, p: Proc) -> str | None:
    """CLAUDE_CONFIG_DIR from the process environment, else the owner's ~/.claude."""
    configured = read_environ(proc, p.pid).get("CLAUDE_CONFIG_DIR")
    home = user_home(p.uid)
    return configured or (os.path.join(home, ".claude") if home else None)


def find_sessions(procs: dict[int, Proc], paths: Paths) -> list[Session]:
    sessions = []
    for p in procs.values():
        if p.comm != "claude" or not (cfg := config_dir(paths.proc, p)):
            continue
        data = read_json(os.path.join(cfg, "sessions", f"{p.pid}.json"))
        if isinstance(data, dict) and str(data.get("procStart")) == str(p.start):
            sessions.append(Session(p, cfg, data))
    return sessions


def seconds(ms) -> float:
    return ms / 1000 if isinstance(ms, (int, float)) else 0.0


def worker_view(s: Session, procs: dict[int, Proc], children: dict[int, list[int]], now: float, proc: str) -> dict:
    d, pid = s.data, s.proc.pid
    cwd = str(d.get("cwd") or "")
    state_since = seconds(d.get("statusUpdatedAt") or d.get("updatedAt") or d.get("startedAt"))
    tree = [pid, *descendants(children, pid)]
    return {
        "id": f"worker:{pid}:{s.proc.start}",
        "pid": pid,
        "user": user_name(s.proc.uid),
        "name": str(d.get("name") or os.path.basename(cwd)),
        "workspace": cwd,
        "state": s.state,
        "stateSince": state_since,
        "lastActivity": state_since,
        "startedAt": seconds(d.get("startedAt")) or state_since,
        "memBytes": sum(procs[q].mem or 0 for q in tree),
        "processes": len(tree),
        "sessionId": s.session_id,
        "version": str(d.get("version") or ""),
        "resumeCommand": resume_command(read_nul_list(f"{proc}/{pid}/cmdline"), s.session_id),
        "closable": is_closable(s.state, state_since, now),
    }


# RAM by program.

# Programs that keep the server up or are the way in: never ended from the app.
SYSTEM_COMMS = frozenset({
    "systemd", "(sd-pam)", "init", "sshd", "sshd-session", "sshd-auth", "sudo", "login", "agetty", "dbus-daemon",
    "dbus-broker", "polkitd", "cron", "crond", "atd", "rsyslogd", "journald", "udevd", "containerd", "dockerd",
    "docker-proxy", "earlyoom", "snapd", "multipathd", "chronyd", "ntpd", "unattended-upgr",
    "networkd-dispat", "packagekitd", "ModemManager", "irqbalance", "qemu-ga", "cloud-init", "fail2ban-server",
})
SYSTEM_PREFIXES = ("systemd-", "containerd-shim")
SBIN = ("/usr/sbin/", "/sbin/", "/usr/local/sbin/")
MEM_GROUPS = 8
MEM_PROCESSES = 6
COMMAND_MAX = 160


def is_system(comm: str) -> bool:
    return comm in SYSTEM_COMMS or comm.startswith(SYSTEM_PREFIXES)


def killable(pid: int, procs: dict[int, Proc], children: dict[int, list[int]], protected: set[int],
             exe: Callable[[int], str | None]) -> bool:
    """Whether the app may end `pid` and its descendants: not PID 1 or a kernel thread, and nothing in its tree is a
    system program (by name, or run from an sbin folder: VPN and other daemons), a Claude Code worker or vpsmon itself
    (which also covers vpsmon's ancestors: the SSH session)."""
    p = procs.get(pid)
    if p is None or pid in (1, 2) or p.ppid == 2 or p.mem is None or exe(pid) is None:
        return False
    tree = [pid, *descendants(children, pid)]
    return not any(q in protected or is_system(procs[q].comm) or (exe(q) or "").startswith(SBIN) for q in tree)


def exe_of(proc: str, pid: int) -> str | None:
    try:
        return os.readlink(f"{proc}/{pid}/exe")
    except OSError:
        return None


def boot_time(proc: str) -> float:
    try:
        with open(f"{proc}/stat") as f:
            return float(next(line.split()[1] for line in f if line.startswith("btime ")))
    except (OSError, StopIteration, ValueError):
        return 0.0


def command_line(proc: str, p: Proc) -> str:
    command = " ".join(read_nul_list(f"{proc}/{p.pid}/cmdline")) or p.comm
    return command if len(command) <= COMMAND_MAX else command[: COMMAND_MAX - 1] + "…"


def memory_groups(procs: dict[int, Proc], children: dict[int, list[int]], protected: set[int], proc: str) -> dict:
    """processBytes and the biggest MemGroups: every process with a memory map, grouped by comm."""
    groups: dict[str, list[Proc]] = {}
    for p in procs.values():
        if p.mem is not None:
            groups.setdefault(p.comm, []).append(p)
    ranked = sorted(groups.items(), key=lambda g: (-sum(p.mem for p in g[1]), g[0]))
    booted, ticks = boot_time(proc), os.sysconf("SC_CLK_TCK")

    def view(p: Proc) -> dict:
        tree = [p.pid, *descendants(children, p.pid)]
        return {
            "id": f"proc:{p.pid}:{p.start}",
            "pid": p.pid,
            "user": user_name(p.uid),
            "command": command_line(proc, p),
            "bytes": p.mem,
            "treeBytes": sum(procs[q].mem or 0 for q in tree),
            "children": len(tree) - 1,
            "startedAt": round(booted + p.start / ticks, 1),
            "killable": killable(p.pid, procs, children, protected, lambda q: exe_of(proc, q)),
        }

    return {
        "processBytes": sum(p.mem for members in groups.values() for p in members),
        "groups": [
            {
                "name": comm,
                "bytes": sum(p.mem for p in members),
                "count": len(members),
                "processes": [view(p) for p in sorted(members, key=lambda p: (-p.mem, p.pid))[:MEM_PROCESSES]],
            }
            for comm, members in ranked[:MEM_GROUPS]
            if sum(p.mem for p in members) > 0
        ],
    }


# Disk actions.


@dataclass(frozen=True)
class Item:
    ref: str
    bytes: int
    label: str = ""

    def public(self) -> dict:
        return {"label": self.label or self.ref, "bytes": self.bytes}

    def stored(self) -> dict:
        return {**self.public(), "ref": self.ref}


class Live:
    """Live facts the disk-action checks consult, each read once and only when asked for.
    Tests pass any fact as a keyword instead of reading it from the machine."""

    used_paths: set[str] | None = None
    mounts: set[str] | None = None

    def __init__(self, paths: Paths, now: float, **facts):
        self.paths, self.now = paths, now
        self.scanned_bytes: dict[str, int] = {}
        self._pinned: set[str] | None = None
        self._pinned_at = 0.0
        self.__dict__.update(facts)

    @cached_property
    def session_ids(self) -> set[str]:
        return {s.session_id for s in find_sessions(read_procs(self.paths.proc), self.paths)}

    @cached_property
    def homes(self) -> list[str]:
        return self.paths.homes()

    @cached_property
    def tools(self) -> set[str]:
        return {t for t in ("journalctl", "apt-get", "docker") if shutil.which(t)}

    def busy(self, path: str) -> bool:
        """Whether a process uses `path` or something inside it, or a filesystem is mounted there or inside it.
        A long scan reads /proc again every PINNED_TTL seconds."""
        live = self.used_paths is None or self.mounts is None
        if self._pinned is None or (live and time.monotonic() - self._pinned_at > PINNED_TTL):
            used = self.used_paths if self.used_paths is not None else read_used_paths(self.paths.proc)
            mounts = self.mounts if self.mounts is not None else read_mounts(self.paths.proc)
            self._pinned, self._pinned_at = with_ancestors([*used, *mounts]), time.monotonic()
        return canonical(path) in self._pinned

    @cached_property
    def unused_images(self) -> dict[str, Item]:
        return docker_unused_images()

    @cached_property
    def dangling_volumes(self) -> dict[str, str]:
        return docker_dangling_anonymous_volumes()

    @cached_property
    def build_cache(self) -> int:
        return docker_build_cache()


@dataclass(frozen=True)
class DiskAction:
    """`check` is the only gate: the scan runs it on every candidate, and `act` runs it again on every item right
    before it frees it. `remove` frees one item; `command` frees them all at once. A `replan` action has too many
    items to keep: the scan stores the biggest few, and `act` selects again from the candidates. `tool` is the program
    the action needs; without it the action is never published."""

    id: str
    risk: str
    noun: str | None  # what the detail counts, a `noun.*` message
    candidates: Callable[[Live], Iterable[str]]
    check: Callable[[Live, str], Item | None]
    remove: Callable[[Live, str], object] | None = None
    command: tuple[str, ...] = ()
    replan: bool = False
    tool: str | None = None

    def plan(self, live: Live, within: Iterable[str] | None = None) -> list[Item]:
        refs = self.candidates(live) if within is None else within
        items = (self.check(live, ref) for ref in refs)
        return sorted((i for i in items if i), key=lambda i: -i.bytes)

    def apply(self, live: Live, refs: Iterable[str]) -> tuple[list[Item], int]:
        """Frees what still qualifies among `refs`: the items freed, biggest first, and how many failed."""
        if self.command:
            items = self.plan(live, refs)
            if items:
                run(list(self.command))
            return items, 0
        done, failed = [], 0
        for ref in refs:
            item = self.check(live, ref)
            if item is None:
                continue
            try:
                self.remove(live, item.ref)
                done.append(item)
            except (OSError, Fail) as e:
                failed += 1
                log(f"{item.ref}: {e}")
        return sorted(done, key=lambda i: -i.bytes), failed

    def summary(self, items: list[Item]) -> dict:
        return {
            "id": self.id,
            "bytes": sum(i.bytes for i in items),
            "risk": self.risk,
            "count": len(items),
            "items": [i.stored() for i in (items[:MAX_ITEMS] if self.replan else items)],
        }


def remove_tree(path: str) -> None:
    if is_real_dir(path):
        shutil.rmtree(path)
    else:
        os.unlink(path)


def remove_as_owner(live: Live, path: str) -> None:
    as_user(acting_uid(path), remove_tree, path)


def truncate_and_unlink(path: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_NOFOLLOW)
    try:
        os.ftruncate(fd, 0)
    finally:
        os.close(fd)
    os.unlink(path)


def quiet_for(live: Live, path: str, quiet: float) -> Item | None:
    """`path` as an item when nothing uses it, it holds no socket or FIFO, and nothing in it changed for `quiet` s."""
    if live.busy(path):
        return None
    tree = tree_stats(path)
    if tree is None or tree.special or live.now - tree.newest < quiet:
        return None
    return Item(path, tree.bytes)


def stale_candidates(live: Live) -> Iterable[str]:
    for root in (live.paths.tmp, live.paths.var_tmp):
        yield from (os.path.join(root, name) for name in listdir(root))


def stale_check(live: Live, path: str) -> Item | None:
    folder, name = os.path.split(path)
    quiet = {live.paths.tmp: DAY, live.paths.var_tmp: WEEK}.get(folder)
    if quiet is None or os.path.normpath(path) != path or is_system_tmp(name) or os.path.realpath(folder) != folder:
        return None
    return quiet_for(live, path, quiet)


def claude_tmp_candidates(live: Live) -> Iterable[str]:
    for base in (n for n in listdir(live.paths.tmp) if CLAUDE_TMP_RE.fullmatch(n)):
        for slug in (s for s in listdir(os.path.join(live.paths.tmp, base)) if s.startswith("-")):
            yield from (os.path.join(live.paths.tmp, base, slug, sid) for sid in listdir(os.path.join(live.paths.tmp, base, slug)))


def claude_tmp_check(live: Live, path: str) -> Item | None:
    """A per-session folder /tmp/claude-<uid>/<slug>/<uuid>, owned by <uid>, of a session that is not alive."""
    parts = inside(path, live.paths.tmp)
    m = CLAUDE_TMP_RE.fullmatch(parts[0]) if parts and len(parts) == 3 else None
    if m is None or not parts[1].startswith("-") or not UUID_RE.fullmatch(parts[2]) or parts[2] in live.session_ids:
        return None
    uid, base = int(m.group(1)), os.path.join(live.paths.tmp, parts[0])
    if not (owned_dir(base, uid) and is_real_dir(os.path.join(base, parts[1])) and owned_dir(path, uid)):
        return None
    if os.path.realpath(live.paths.tmp) != live.paths.tmp:
        return None
    return quiet_for(live, path, CLAUDE_TMP_QUIET)


def walk_files(root: str) -> Iterable[str]:
    """Every file under `root` on its filesystem, skipping node_modules and .git."""
    try:
        dev = os.lstat(root).st_dev
    except OSError:
        return
    for folder, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in PRUNE_DIRS and same_device(os.path.join(folder, d), dev)]
        yield from (os.path.join(folder, f) for f in files)


def same_device(path: str, dev: int) -> bool:
    try:
        return os.lstat(path).st_dev == dev
    except OSError:
        return False


def log_candidates(live: Live) -> Iterable[str]:
    for root in live.paths.log_roots:
        yield from (p for p in walk_files(root) if p.endswith(".log"))


def log_check(live: Live, path: str) -> Item | None:
    root = next((r for r in live.paths.log_roots if inside(path, r)), None)
    if root is None or not path.endswith(".log") or os.path.realpath(os.path.dirname(path)) != os.path.dirname(path):
        return None
    parts = inside(path, root)
    if PRUNE_DIRS.intersection(parts[:-1]) or live.busy(path):
        return None
    # A log inside what tmp-stale or claude-tmp frees goes with it, and counts there.
    if root in (live.paths.tmp, live.paths.var_tmp) and stale_check(live, os.path.join(root, parts[0])):
        return None
    if root == live.paths.tmp and len(parts) > 3 and claude_tmp_check(live, os.path.join(root, *parts[:3])):
        return None
    try:
        st = os.lstat(path)
    except OSError:
        return None
    return Item(path, st.st_blocks * 512) if stat.S_ISREG(st.st_mode) and st.st_size > BIG_LOG else None


def truncate_log(live: Live, path: str) -> None:
    as_user(acting_uid(path), truncate_and_unlink, path)


def version_candidates(live: Live) -> Iterable[str]:
    for home in live.homes:
        folder = os.path.join(home, VERSIONS_DIR)
        yield from (os.path.join(folder, n) for n in listdir(folder) if VERSION_RE.fullmatch(n))


def version_check(live: Live, path: str) -> Item | None:
    """A Claude Code version older than the one ~/.local/bin/claude points to, that no process runs."""
    folder, name = os.path.split(path)
    home = next((h for h in live.homes if folder == os.path.join(h, VERSIONS_DIR)), None)
    if home is None or not VERSION_RE.fullmatch(name) or os.path.realpath(folder) != folder:
        return None
    current = os.path.basename(os.path.realpath(os.path.join(home, CLAUDE_LINK)))
    if not VERSION_RE.fullmatch(current) or version_key(name) >= version_key(current):
        return None
    if os.path.islink(path) or not os.path.lexists(path) or live.busy(path):
        return None
    tree = tree_stats(path)
    return Item(path, tree.bytes) if tree else None


def journal_files(root: str) -> list[tuple[str, int, float, bool]]:
    files = []
    for folder, _, names in os.walk(root):
        for name in names:
            if name.endswith((".journal", ".journal~")):
                st = os.lstat(os.path.join(folder, name))
                files.append((os.path.join(folder, name), st.st_blocks * 512, st.st_mtime, "@" in name))
    return files


def journal_check(live: Live, path: str) -> Item | None:
    if path != live.paths.journal:
        return None
    files = journal_files(path)
    sizes = {p: size for p, size, _, _ in files}
    excess = sum(sizes[p] for p in journal_excess(files, JOURNAL_KEEP))
    return Item(path, excess) if excess else None


def deb_check(live: Live, path: str) -> Item | None:
    if os.path.dirname(path) != live.paths.apt_archives or not path.endswith(".deb"):
        return None
    try:
        st = os.lstat(path)
    except OSError:
        return None
    return Item(path, st.st_blocks * 512) if stat.S_ISREG(st.st_mode) else None


def pkg_cache_candidates(live: Live) -> list[str]:
    return [os.path.join(h, rel) for h in live.homes for rel in PKG_CACHES]


def pkg_cache_check(live: Live, path: str) -> Item | None:
