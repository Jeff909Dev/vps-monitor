DROP_FLAGS_WITH_VALUE = frozenset({"--plugin-dir", "--resume", "-r", "--session-id"})
DROP_FLAGS = frozenset({"--continue", "-c"})


def resume_command(argv: list[str], session_id: str) -> str:
    kept, i = [], 1
    while i < len(argv):
        arg = argv[i]
        i += 1
        name, has_value = arg.split("=", 1)[0], "=" in arg
        if arg in DROP_FLAGS or (name in DROP_FLAGS_WITH_VALUE and has_value):
            continue
        if name in DROP_FLAGS_WITH_VALUE:
            if i < len(argv) and not argv[i].startswith("-"):
                i += 1
            continue
        kept.append(arg)
    return shlex.join(["claude", *kept, "--resume", session_id])


def growth_per_hour(history: list[dict], mount: str, now: float) -> float | None:
    """Least-squares slope of `mount`'s used bytes over the last day of history, in bytes per hour; None with less
    than an hour of it."""
    points = [(r["at"] / HOUR, r["disks"][mount]) for r in history
              if now - DAY <= r["at"] <= now and mount in r["disks"]]
    if len(points) < 2:
        return None
    xs, ys = zip(*points)
    if (max(xs) - min(xs)) * HOUR < HOUR:
        return None
    mx, my = sum(xs) / len(xs), sum(ys) / len(ys)
    sxx = sum((x - mx) ** 2 for x in xs)
    sxy = sum((x - mx) * (y - my) for x, y in points)
    return sxy / sxx


def full_in_hours(free: int, growth: float | None) -> float | None:
    return free / growth if growth and growth > 0 else None


def is_closable(state: str, last_activity: float, now: float) -> bool:
    return state == "idle" and now - last_activity >= CLOSABLE_AFTER


def sort_workers(workers: list[dict]) -> list[dict]:
    rank = {"busy": 0, "idle": 1}
    return sorted(workers, key=lambda w: (rank.get(w["state"], 2), w["lastActivity"]))


def descendants(children: dict[int, list[int]], pid: int) -> list[int]:
    found, queue = [], list(children.get(pid, ()))
    while queue:
        q = queue.pop()
        found.append(q)
        queue.extend(children.get(q, ()))
    return found


def parse_oom_kill(message: str) -> tuple[int, str] | None:
    m = KERNEL_OOM_RE.search(message) or EARLYOOM_RE.search(message)
    return (int(m.group(1)), m.group(2)) if m else None


def parse_config(data) -> dict:
    """/etc/vpsmon/config.json, keeping only what is valid: anything else means the defaults."""
    services = data.get("services") if isinstance(data, dict) else None
    if not isinstance(services, list):
        services = []
    return {"services": [s for s in services if isinstance(s, str) and UNIT_RE.fullmatch(s)]}


def unit_name(unit: str) -> str:
    return unit.removesuffix(".service")


def services_view(watched: list[str], active: list[str], failed: list[str]) -> list[dict]:
    """Every watched unit, active when `systemctl is-active` says so, then every failed unit the config does not list."""
    listed = {unit_name(u) for u in watched}
    view = [{"name": u, "active": i < len(active) and active[i].strip() == "active"} for i, u in enumerate(watched)]
    return view + [{"name": unit_name(u), "active": False} for u in failed if unit_name(u) not in listed]


def journal_excess(files: list[tuple[str, int, float, bool]], keep: int) -> list[str]:
    """What `journalctl --vacuum-size` removes: archived files, oldest first, until all files fit in `keep`."""
    total = sum(size for _, size, _, _ in files)
    gone = []
    for path, size, _, _ in sorted((f for f in files if f[3]), key=lambda f: f[2]):
        if total <= keep:
            break
        gone.append(path)
        total -= size
    return gone


def inside(path: str, root: str) -> list[str] | None:
    """The components of `path` below `root`, or None when `path` is not a normalized path strictly inside it."""
    if os.path.normpath(path) != path or not path.startswith(root.rstrip("/") + "/"):
        return None
    return path[len(root.rstrip("/")) + 1 :].split("/")


def within(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


def with_ancestors(paths: Iterable[str]) -> set[str]:
    found: set[str] = set()
    for path in paths:
        while path not in found and path not in ("/", ""):
            found.add(path)
            path = os.path.dirname(path)
    return found


def is_system_tmp(name: str) -> bool:
    return bool(CLAUDE_TMP_RE.fullmatch(name)) or any(fnmatch.fnmatchcase(name, p) for p in SYSTEM_TMP)


def version_key(name: str) -> tuple[int, ...]:
    return tuple(int(n) for n in name.split("."))


def parse_docker_size(text: str) -> int:
    """`238MB`, `1.18GB`, or a `docker system df` reclaimable column such as `5.238GB (71%)`."""
    m = re.fullmatch(r"([\d.]+)\s*([kKMGTP]?)B(?:\s*\(\d+%\))?", text.strip())
    if not m:
        return 0
    return int(float(m.group(1)) * 1000 ** " kMGTP".index(m.group(2).replace("K", "k") or " "))


# Facts: small readers that return plain data. Each takes the /proc root, so tests can hand them a fake one.


@dataclass(frozen=True)
class Proc:
    pid: int
    ppid: int
    comm: str
    start: int  # clock ticks after boot, /proc/<pid>/stat field 22: with the pid, it names one process for good
    uid: int
    mem: int | None  # RssAnon + VmSwap: what ending it gives back; None without a memory map (kernel threads, zombies)


def read_proc(proc: str, pid: int) -> Proc | None:
    try:
        with open(f"{proc}/{pid}/stat", "rb") as f:
            raw = f.read().decode(errors="replace")
        with open(f"{proc}/{pid}/status", "rb") as f:
            status = dict(line.split(b":", 1) for line in f.read().splitlines() if b":" in line)
    except OSError:
        return None
    left, right = raw.index("("), raw.rindex(")")
    rest = raw[right + 2 :].split()
    uid = int(status.get(b"Uid", b"0 0").split()[1])
    mem = None
    if b"RssAnon" in status:
        mem = sum(int(status.get(k, b"0 kB").split()[0]) for k in (b"RssAnon", b"VmSwap")) * 1024
    return Proc(pid, int(rest[1]), raw[left + 1 : right], int(rest[19]), uid, mem)


def read_procs(proc: str) -> dict[int, Proc]:
    procs = {}
    for name in listdir(proc):
        if name.isdigit() and (p := read_proc(proc, int(name))):
            procs[p.pid] = p
    return procs


def children_of(procs: dict[int, Proc]) -> dict[int, list[int]]:
    children: dict[int, list[int]] = {}
    for p in procs.values():
        children.setdefault(p.ppid, []).append(p.pid)
    return children


def read_nul_list(path: str) -> list[str]:
    try:
        with open(path, "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def read_environ(proc: str, pid: int) -> dict[str, str]:
    return dict(kv.split("=", 1) for kv in read_nul_list(f"{proc}/{pid}/environ") if "=" in kv)


@functools.cache
def user_name(uid: int) -> str:
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


@functools.cache
def user_home(uid: int) -> str | None:
    try:
        return pwd.getpwuid(uid).pw_dir
    except KeyError:
        return None


def read_json(path: str):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def read_meminfo(proc: str) -> dict[str, int]:
    info = {}
    with open(f"{proc}/meminfo") as f:
        for line in f:
            key, value = line.split(":", 1)
            info[key] = int(value.split()[0]) * 1024
    return info


def disk_usage(mount: str) -> dict[str, int]:
    st = os.statvfs(mount)
    return {
        "totalBytes": st.f_blocks * st.f_frsize,
        "usedBytes": (st.f_blocks - st.f_bfree) * st.f_frsize,
        "freeBytes": st.f_bavail * st.f_frsize,
    }


def run(cmd: list[str], ok_codes: tuple[int, ...] = (0,), timeout: float = 900) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        raise Fail("err.tool-start", tool=cmd[0], detail=str(e)) from e
    if r.returncode not in ok_codes:
        raise Fail("err.tool-failed", tool=cmd[0], detail=r.stderr.strip()[:300])
    return r.stdout


def has_systemd() -> bool:
    return os.path.isdir("/run/systemd/system") and shutil.which("systemctl") is not None


def read_services(watched: list[str]) -> list[dict]:
    if not has_systemd():
        return []
    try:
        active = run(["systemctl", "is-active", "--", *watched], ok_codes=tuple(range(256)), timeout=5) if watched else ""
        failed = run(["systemctl", "list-units", "--state=failed", "--plain", "--no-legend", "--no-pager"], timeout=5)
    except Fail as e:
        log(f"services: {e}")
        return []
    return services_view(watched, active.splitlines(), [line.split()[0] for line in failed.splitlines() if line.split()])


def oom_kills(since: float) -> list[dict]:
    """Kills by the kernel OOM killer and by earlyoom, newest first. Kernel lines from every boot, not just this one."""
    if not shutil.which("journalctl"):
        return []
    try:
        out = run(
            ["journalctl", "--since", f"@{int(since)}", "-o", "json", "--no-pager", "-q",
             "--grep", "Killed process|sending SIG", "_TRANSPORT=kernel", "+", "_SYSTEMD_UNIT=earlyoom.service"],
            ok_codes=(0, 1),
            timeout=5,
        )
    except Fail as e:
        log(f"oom: {e}")
        return []
    kills: dict[int, dict] = {}
    for line in out.splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        message = entry.get("MESSAGE")
        hit = parse_oom_kill(message) if isinstance(message, str) else None
        if hit:
            at = int(entry["__REALTIME_TIMESTAMP"]) / 1e6
            kills[hit[0]] = {"at": at, "process": hit[1], "pid": hit[0]}
    return sorted(kills.values(), key=lambda k: -k["at"])


@dataclass(frozen=True)
class Tree:
    bytes: int  # disk usage, du semantics: hard links once, other filesystems left out
    newest: float  # the newest mtime or ctime of anything inside: tar and cp -p keep old mtimes, never old ctimes
    special: bool  # holds a socket or a FIFO, which only a live program makes and uses


def tree_stats(root: str) -> Tree | None:
    """What lies under `root`, symlinks not followed, or None when `root` is gone."""
    try:
        st = os.lstat(root)
    except OSError:
        return None
    total, newest = st.st_blocks * 512, max(st.st_mtime, st.st_ctime)
    special = stat.S_ISSOCK(st.st_mode) or stat.S_ISFIFO(st.st_mode)
    if not stat.S_ISDIR(st.st_mode):
        return Tree(total, newest, special)
    seen: set[tuple[int, int]] = set()
    stack = [root]
    while stack:
        try:
            entries = os.scandir(stack.pop())
        except OSError:
            continue
        with entries:
            for e in entries:
                try:
                    s = e.stat(follow_symlinks=False)
                except OSError:
                    continue
                newest = max(newest, s.st_mtime, s.st_ctime)
                special = special or stat.S_ISSOCK(s.st_mode) or stat.S_ISFIFO(s.st_mode)
                if s.st_dev != st.st_dev:
                    continue
                if stat.S_ISDIR(s.st_mode):
                    stack.append(e.path)
                elif s.st_nlink > 1:
                    if (s.st_dev, s.st_ino) in seen:
                        continue
                    seen.add((s.st_dev, s.st_ino))
                total += s.st_blocks * 512
    return Tree(total, newest, special)


def listdir(path: str) -> list[str]:
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def is_real_dir(path: str) -> bool:
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def owned_dir(path: str, uid: int) -> bool:
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == uid


def canonical(path: str) -> str:
    """`path` with every folder above it resolved, the last component left as is (a symlink stays the link)."""
    folder, name = os.path.split(path)
    return os.path.join(os.path.realpath(folder), name)


def read_used_paths(proc: str) -> set[str]:
    """Every path a process has as its cwd, root or exe, holds open, or maps."""
    found = set()
    for pid in listdir(proc):
        if not pid.isdigit():
            continue
        base = f"{proc}/{pid}"
        for link in ["cwd", "root", "exe", *(f"fd/{fd}" for fd in listdir(f"{base}/fd"))]:
            try:
                target = os.readlink(f"{base}/{link}")
            except OSError:
                continue
            if target.startswith("/"):
                found.add(target.removesuffix(" (deleted)"))
        try:
            with open(f"{base}/maps", "rb") as f:
                for line in f:
                    fields = line.rstrip(b"\n").split(None, 5)
                    if len(fields) == 6 and fields[5].startswith(b"/"):
                        found.add(fields[5].decode(errors="replace").removesuffix(" (deleted)"))
        except OSError:
            pass
    return found


@dataclass(frozen=True)
class Mount:
    device: str
    path: str
    fstype: str


def parse_mounts(text: str) -> list[Mount]:
    """A /proc/<pid>/mounts table, in mount order. Paths escape spaces and other bytes as octal (`\\040`)."""
    def unescape(field: str) -> str:
        return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), field)

    return [Mount(*map(unescape, fields[:3])) for line in text.splitlines() if len(fields := line.split()) >= 3]


def read_mount_table(path: str) -> list[Mount]:
    try:
        with open(path) as f:
            return parse_mounts(f.read())
    except OSError:
        return []


def read_mounts(proc: str) -> set[str]:
    return {m.path for m in read_mount_table(f"{proc}/self/mounts")}


def real_disks(mounts: list[Mount], is_dir: Callable[[str], bool] = os.path.isdir) -> list[Mount]:
    """The disks status lists: / whatever its filesystem, then one mount per block device, by path.

    A path mounted twice shows its last mount. Only block-device filesystems count (DISK_FSTYPES): never snaps, tmpfs,
    overlay, proc, sys, cgroup or a network filesystem, whose statvfs can hang on a dead server. /boot and /boot/efi
    hold the kernel, not data. A mount on a file (Docker's /etc/hosts) is no disk. Bind mounts and Docker volumes
    repeat a device, so each device keeps its shortest path, and ZFS datasets share their pool's free space, so a pool
    counts as one device."""
    visible = {m.path: m for m in mounts}
    root = visible.get("/", Mount("", "/", ""))
    others = [m for m in visible.values()
              if m.path != "/" and m.fstype in DISK_FSTYPES and not within(m.path, "/boot") and is_dir(m.path)]
    kept: dict[str, Mount] = {}
    for m in [root, *others]:
        key = m.device.split("/", 1)[0] if m.fstype == "zfs" else m.device
        if key not in kept or (len(m.path), m.path) < (len(kept[key].path), kept[key].path):
            kept[key] = m
    return sorted(kept.values(), key=lambda m: (m.path != "/", m.path))


def read_disks(proc: str) -> list[dict]:
    """Every real disk (see real_disks) in PID 1's mount table, with its statvfs sizes."""
    disks = []
    for m in real_disks(read_mount_table(f"{proc}/1/mounts")):
        try:
            usage = disk_usage(m.path)
        except OSError:
            if m.path == "/":
                raise
            continue
        disks.append({"mount": m.path, "device": m.device, "fstype": m.fstype, **usage})
    return disks


def acting_uid(path: str) -> int:
    """Whom to delete `path` as: the first user but root who owns a folder above it, because that user can swap what
    lies below for a symlink anywhere; root when root owns every folder above it."""
    folder = "/"
    for part in os.path.dirname(path).strip("/").split("/"):
        folder = os.path.join(folder, part)
        uid = os.lstat(folder).st_uid
        if uid != 0:
            return uid
    return 0


def as_user(uid: int, fn: Callable[..., object], *args) -> None:
    """Runs `fn(*args)` with the rights of `uid`, in a child process when that is not who vpsmon runs as."""
    if uid == os.geteuid():
        fn(*args)
        return
    pid = os.fork()
    if pid == 0:
        code = 1
        try:
            try:
                gid = pwd.getpwuid(uid).pw_gid
            except KeyError:
                gid = uid
            os.setgroups([])
            os.setgid(gid)
            os.setuid(uid)
            fn(*args)
            code = 0
        except BaseException as e:
            print(f"vpsmon: {e}", file=sys.stderr, flush=True)
        finally:
            os._exit(code)
    _, status = os.waitpid(pid, 0)
    if os.waitstatus_to_exitcode(status) != 0:
        raise OSError(f"failed as uid {uid}")


def docker_unused_images() -> dict[str, Item]:
    containers = run(["docker", "ps", "-aq", "--no-trunc"]).split()
    used = set(run(["docker", "inspect", "--format", "{{.Image}}", *containers]).split()) if containers else set()
    unused = {}
    for line in run(["docker", "image", "ls", "--no-trunc", "--format", "{{json .}}"]).splitlines():
        image = json.loads(line)
        image_id = image["ID"]
        if image_id in used:
            continue
        name = f'{image["Repository"]}:{image["Tag"]}'
        unused[image_id] = Item(image_id, parse_docker_size(image["Size"]), f"{name} ({image_id.removeprefix('sha256:')[:12]})")
    return unused


def docker_dangling_anonymous_volumes() -> dict[str, str]:
    names = [n for n in run(["docker", "volume", "ls", "-q", "-f", "dangling=true"]).split() if HEX64_RE.fullmatch(n)]
    if not names:
        return {}
    volumes = json.loads(run(["docker", "volume", "inspect", *names]))
    return {v["Name"]: v["Mountpoint"] for v in volumes if "com.docker.volume.anonymous" in (v.get("Labels") or {})}


def docker_build_cache() -> int:
    """The build cache `docker system df` reports as reclaimable."""
    for line in run(["docker", "system", "df", "--format", "{{json .}}"]).splitlines():
        row = json.loads(line)
        if row.get("Type") == "Build Cache":
            return parse_docker_size(str(row.get("Reclaimable", "")))
    return 0


