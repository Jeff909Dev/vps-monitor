        return None
    if live.busy(path):
        return None
    tree = tree_stats(path)
    return Item(path, tree.bytes) if tree else None


def volume_check(live: Live, name: str) -> Item | None:
    mountpoint = live.dangling_volumes.get(name) if HEX64_RE.fullmatch(name) else None
    if mountpoint is None:
        return None
    return Item(name, live.scanned_bytes.get(name) or (tree_stats(mountpoint) or Tree(0, 0, False)).bytes)


