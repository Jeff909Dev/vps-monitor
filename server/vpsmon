# Disk map: the used space in blocks that add up to all of it.


@dataclass(frozen=True)
class MapGroup:
    """One block of the disk map. `roots` are absolute paths, globs allowed within a component; a root that is a file
    (a swapfile) is sized from its blocks, since du lists only directories. A root inside another group's root is that
    group's: the most specific root wins. Children are the directories `levels` below the roots (0: the roots
    themselves), skipping other groups' roots. The group with no roots is the rest of the disk. `freeable` names the
    disk actions that free space here; an action listed by several groups counts each item in the group whose roots
    hold its path."""

    id: str
    roots: tuple[str, ...] = ()
    levels: int = 1
    freeable: tuple[str, ...] = ()


MAP_GROUPS = (
    MapGroup("home", ("/home/*", "/root"), freeable=("big-logs", "claude-versions")),
    MapGroup("claude", ("/home/*/.claude", "/root/.claude")),
    MapGroup(
        "caches", ("/var/cache", "/home/*/.cache", "/home/*/.npm", "/root/.cache", "/root/.npm"),
        freeable=("pkg-caches", "apt-cache"),
    ),
    MapGroup(
        "docker", ("/var/lib/docker", "/var/lib/containerd"),
        freeable=("docker-images", "docker-volumes", "docker-build-cache"),
    ),
    MapGroup("logs", ("/var/log",), freeable=("journal", "big-logs")),
    MapGroup("temp", ("/tmp", "/var/tmp"), freeable=("tmp-stale", "claude-tmp", "big-logs")),
    MapGroup("swap", ("/swapfile*", "/swap.img"), levels=0),
    MapGroup("system", ("/usr", "/opt", "/boot", "/snap", "/var/lib/snapd"), levels=0),
    MapGroup("rest"),
)
REST = next(g for g in MAP_GROUPS if not g.roots)
# The rest's children: the directories this deep that no group holds, and what shallower ones hold loose.
REST_DEPTH = 3


def depth(path: str) -> int:
    return path.rstrip("/").count("/")


def held_by(path: str, pattern: str) -> bool:
    """Whether `path` is a root matching `pattern`, or lies below one."""
    parts = path.rstrip("/").split("/")
    n = depth(pattern) + 1
    return path.startswith("/") and len(parts) >= n and fnmatch.fnmatchcase("/".join(parts[:n]), pattern)


# One du pass prints every directory the map needs, and no deeper.
DU_DEPTH = max([depth(r) + g.levels for g in MAP_GROUPS for r in g.roots] + [REST_DEPTH])


def matching(pattern: str, sizes: dict[str, int]) -> list[str]:
    if not any(c in pattern for c in "*?["):
        return [pattern] if pattern in sizes else []
    return sorted(p for p in sizes if depth(p) == depth(pattern) and held_by(p, pattern))


def parse_du(text: str) -> dict[str, int]:
    sizes = {}
    for line in text.splitlines():
        size, tab, path = line.partition("\t")
        if tab and size.isdigit():
            sizes[path] = int(size)
    return sizes


def outermost(paths: Iterable[str]) -> list[str]:
    """The paths that lie inside none of the others."""
    paths = list(paths)
    return [p for p in paths if not any(o != p and within(p, o) for o in paths)]


def map_group(spec: MapGroup, size: int, children: dict[str, int]) -> dict:
    biggest = sorted(((p, b) for p, b in children.items() if b > 0), key=lambda c: (-c[1], c[0]))[:MAP_CHILDREN]
    return {
        "id": spec.id,
        "bytes": size,
        "children": [{"path": p, "bytes": b} for p, b in biggest],
    }


def build_map(du: dict[str, int], used: int, files: dict[str, int]) -> dict:
    """The map from one `du -B1` pass (directory -> bytes), the root files du does not list, and statvfs used bytes.
    Each byte counts once, in the group with the most specific root over it; the rest is what no group covers, so the
    groups always add up to `usedBytes`."""
    sizes = {**du, **files}
    subdirs: dict[str, list[str]] = {}
    for path in du:
        if path != "/":
            subdirs.setdefault(os.path.dirname(path), []).append(path)
    owner: dict[str, MapGroup] = {}
    for spec in MAP_GROUPS:
        for pattern in spec.roots:
            for path in matching(pattern, sizes):
                owner.setdefault(path, spec)

    def own(path: str) -> int:
        """`path` minus the roots inside it, which count in their own groups."""
        inner = outermost(r for r in owner if r != path and within(r, path))
        return sizes[path] - sum(sizes[r] for r in inner)

    groups = []
    for spec in MAP_GROUPS:
        if spec is REST:
            continue
        roots = [r for r, g in owner.items() if g is spec]
        listed = roots
        for _ in range(spec.levels):
            listed = [c for p in listed for c in subdirs.get(p, ()) if c not in owner]
        groups.append(map_group(spec, sum(own(r) for r in roots), {p: own(p) for p in listed}))
    known = sum(g["bytes"] for g in groups)
    if known > used:
        log(f"map: the groups add up to {known} bytes, more than the {used} in use; the rest is 0")
        used = known
    groups = sorted((g for g in groups if g["bytes"] > 0), key=lambda g: -g["bytes"])
    if used > known:
        covered = outermost(owner)
        outside = {
            p: size - sum(sizes[r] for r in covered if within(r, p))
            for p, size in du.items()
            if depth(p) <= REST_DEPTH and not any(within(p, r) for r in covered)
        }
        loose = {
            p: b - sum(outside.get(c, 0) for c in subdirs.get(p, ())) if depth(p) < REST_DEPTH else b
            for p, b in outside.items()
        }
        groups.append(map_group(REST, used - known, loose))
    return {"usedBytes": used, "groups": groups}


def freeable_by_group(actions: list[dict]) -> dict[str, dict[str, int]]:
    """What each published disk action would free, by the map group it frees it from."""
    shares: dict[str, dict[str, int]] = {}

    def add(group: MapGroup, action_id: str, size: int) -> None:
        share = shares.setdefault(group.id, {})
        share[action_id] = share.get(action_id, 0) + size

    for action in actions:
        owners = [g for g in MAP_GROUPS if action.get("id") in g.freeable]
        if len(owners) == 1:
            add(owners[0], action["id"], action["bytes"])
            continue
        for item in action.get("items", []) if owners else []:
            ref = item.get("ref") or item.get("label") or ""
            holders = [(depth(r), g) for g in owners for r in g.roots if held_by(ref, r)]
            add(max(holders, key=lambda h: h[0])[1] if holders else owners[0], action["id"], item["bytes"])
    return shares


def map_view(stored: dict | None, actions: list[dict], tr: Text) -> dict:
    stored = stored or {"usedBytes": 0, "groups": []}
    shares = freeable_by_group(actions)
    groups = []
    for g in stored["groups"]:
        share = shares.get(g["id"], {})
        ranked = sorted((a for a, b in share.items() if b > 0), key=lambda a: (-share[a], a))
        groups.append({
            "id": g["id"],
            "title": tr(f"map.{g['id']}.title"),
            "hint": tr(f"map.{g['id']}.hint"),
            "bytes": g["bytes"],
            "freeableBytes": min(g["bytes"], sum(share.values())),
            "actions": ranked,
            "children": g["children"],
        })
    return {"usedBytes": stored["usedBytes"], "groups": groups}


def root_files(patterns: Iterable[str]) -> dict[str, int]:
    sizes = {}
    for pattern in patterns:
        for path in glob.glob(pattern):
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                sizes[path] = st.st_blocks * 512
    return sizes


def measure_map() -> dict:
    out = run(
        ["du", "-x", "-B1", f"--max-depth={DU_DEPTH}", f"--threshold={DU_THRESHOLD}", "/"],
        ok_codes=(0, 1),
        timeout=3 * HOUR,
    )
    return build_map(parse_du(out), disk_usage("/")["usedBytes"], root_files(r for g in MAP_GROUPS for r in g.roots))


# State files.


def write_json_atomic(path: str, data) -> None:
    tmp = f"{path}.tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


@contextmanager
def state_lock(paths: Paths, wait: bool = True):
    os.makedirs(paths.state, exist_ok=True)
    fd = os.open(paths.file("lock"), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Fail("err.busy") from None
        yield
    finally:
        os.close(fd)


def scan_running(paths: Paths) -> bool:
    try:
        fd = os.open(paths.file("scan.lock"), os.O_RDONLY)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        return False
    except BlockingIOError:
        return True
    finally:
        os.close(fd)


def read_scan(paths: Paths) -> dict:
    """The saved scan, or {} when there is none or it is in another format: the next sample starts a fresh one."""
    scan = read_json(paths.file("scan.json"))
    return scan if isinstance(scan, dict) and scan.get("schema") == SCAN_SCHEMA else {}


def last_scan_attempt(paths: Paths) -> float:
    scan = read_scan(paths)
    try:
        started = os.stat(paths.file("scan.lock")).st_mtime
    except OSError:
        started = 0.0
    return max(scan.get("at") or 0.0, started)


def read_history(paths: Paths, since: float) -> list[dict]:
    """The rows since `since`, oldest first. Rows from 0.2.0 hold only root's used bytes, as diskUsedBytes: they read
    as `disks: {"/": diskUsedBytes}`, so root's growth carries across the upgrade."""
    rows = []
    try:
        with open(paths.file("history.jsonl")) as f:
            for line in f:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict) and row.get("at", 0) >= since:
                    legacy = row.pop("diskUsedBytes", None)
                    row.setdefault("disks", {} if legacy is None else {"/": legacy})
                    rows.append(row)
    except OSError:
        pass
    return sorted(rows, key=lambda r: r["at"])


def append_line(path: str, line: str, mode: int) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, mode)
    try:
        os.write(fd, line.encode())
    finally:
        os.close(fd)


def audit(paths: Paths, record: dict) -> None:
    record = {"at": time.time(), "user": os.environ.get("SUDO_USER", ""), **record}
    append_line(paths.audit_log, json.dumps(record, ensure_ascii=False) + "\n", 0o640)


# Commands.


def cmd_status(paths: Paths, now: float, tr: Text) -> dict:
    procs = read_procs(paths.proc)
    children = children_of(procs)
    sessions = find_sessions(procs, paths)
    workers = sort_workers([worker_view(s, procs, children, now, paths.proc) for s in sessions])
    protected = {s.proc.pid for s in sessions} | {os.getpid()}
    mem = read_meminfo(paths.proc)
    history = read_history(paths, now - DAY)
    load = os.getloadavg()
    with open(f"{paths.proc}/uptime") as f:
        uptime = int(float(f.read().split()[0]))
    scan = read_scan(paths)
    actions = [a for a in scan.get("actions", []) if a.get("id") in ACTIONS]
    return {
        "schema": SCHEMA,
        "ok": True,
        "version": VERSION,
        "host": socket.gethostname(),
        "at": round(now, 1),
        "uptimeSec": uptime,
        "cpu": {"cores": os.cpu_count(), "load1": load[0], "load5": load[1], "load15": load[2]},
        "memory": {
            "totalBytes": mem["MemTotal"],
            "availableBytes": mem["MemAvailable"],
            "swapTotalBytes": mem["SwapTotal"],
            "swapUsedBytes": mem["SwapTotal"] - mem["SwapFree"],
            **memory_groups(procs, children, protected, paths.proc),
        },
        "disks": [with_trend(disk, history, now) for disk in read_disks(paths.proc)],
        "services": read_services(parse_config(read_json(paths.config))["services"]),
        "oomKills": oom_kills(now - DAY),
        "workers": workers,
        "history": history,
        "scan": {
            "at": scan.get("at"),
            "running": scan_running(paths),
            "actions": [v for a in actions if (v := action_view(a, tr))],
            "map": map_view(scan.get("map"), actions, tr),
        },
    }


def with_trend(disk: dict, history: list[dict], now: float) -> dict:
    growth = growth_per_hour(history, disk["mount"], now)
    return {**disk, "growthBytesPerHour": growth, "fullInHours": full_in_hours(disk["freeBytes"], growth)}


def start_background_scan(paths: Paths) -> bool:
    """Starts `scan` so that it outlives ssh and the timer: as the transient unit vpsmon-scan where systemd runs, else
    as a detached child in its own session (containers). The scan lock keeps a second one from running."""
    argv = [sys.executable, SELF, "scan"]
    if has_systemd() and shutil.which("systemd-run"):
        env = [f"--setenv=VPSMON_PREFIX={os.environ['VPSMON_PREFIX']}"] if os.environ.get("VPSMON_PREFIX") else []
        r = subprocess.run(["systemd-run", "--unit=vpsmon-scan", "--collect", "--quiet", *env, *argv],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return True
        log(f"systemd-run: {r.stderr.strip()}")
    os.makedirs(paths.state, exist_ok=True)
    try:
        with open(paths.file("scan.log"), "w") as out:
            subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=out, start_new_session=True)
    except OSError as e:
        log(f"scan: {e}")
        return False
    return True


def cmd_sample(paths: Paths, now: float) -> dict:
    sessions = find_sessions(read_procs(paths.proc), paths)
    mem = read_meminfo(paths.proc)
    row = {
        "at": round(now, 1),
        "disks": {d["mount"]: d["usedBytes"] for d in read_disks(paths.proc)},
        "memAvailableBytes": mem["MemAvailable"],
        "swapUsedBytes": mem["SwapTotal"] - mem["SwapFree"],
        "busy": sum(s.state == "busy" for s in sessions),
        "idle": sum(s.state == "idle" for s in sessions),
    }
    os.makedirs(paths.state, exist_ok=True)
    history = paths.file("history.jsonl")
    append_line(history, json.dumps(row) + "\n", 0o644)
    if os.path.getsize(history) > HISTORY_TRIM_AT:
        with state_lock(paths):
            rows = read_history(paths, now - HISTORY_KEEP)
            tmp = f"{history}.tmp"
            with open(tmp, "w") as f:
                f.writelines(json.dumps(r) + "\n" for r in rows)
            os.replace(tmp, history)
    started = False
    if now - last_scan_attempt(paths) >= SCAN_EVERY and not scan_running(paths):
        started = start_background_scan(paths)
    return {"ok": True, "sample": row, "scanStarted": started}


def lower_priority() -> None:
    """CPU nice 19 and the idle IO class for this process and what it runs (du), with whatever the host has."""
    try:
        os.nice(19 - os.nice(0))
    except OSError:
        pass
    if shutil.which("ionice"):
        subprocess.run(["ionice", "-c3", "-p", str(os.getpid())], capture_output=True)


def log(message: str) -> None:
    print(f"vpsmon: {message}", file=sys.stderr, flush=True)


def cmd_scan(paths: Paths, background: bool) -> dict:
    if background:
        if scan_running(paths):
            return {"ok": True, "running": True}
        if start_background_scan(paths):
            return {"ok": True, "started": True}
        if scan_running(paths):
            return {"ok": True, "running": True}
        raise Fail("err.scan-start")
    os.makedirs(paths.state, exist_ok=True)
    fd = os.open(paths.file("scan.lock"), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return {"ok": True, "running": True}
    os.utime(fd)
    lower_priority()
    started = time.time()
    live = Live(paths, started)
    actions = []
    for action in published(live):
        t = time.monotonic()
        try:
            items = action.plan(live)
        except Exception as e:  # one broken source (docker down, say) must not cost the other actions
            log(f"{action.id}: {e}")
            continue
        summary = action.summary(items)
        log(f"{action.id}: {len(items)} items, {summary['bytes']} bytes, {time.monotonic() - t:.0f}s")
        if summary["bytes"] > 0:
            actions.append(summary)
    # The actions first: the map's du pass over the whole disk takes much longer, and a rescan should not wait on it.
    write_scan(paths, started, actions, None)
    t = time.monotonic()
    try:
        disk_map = measure_map()
        log(f"map: {len(disk_map['groups'])} groups, {time.monotonic() - t:.0f}s")
    except Fail as e:
        disk_map = None
        log(f"map: {e}")
    scan = write_scan(paths, started, actions, disk_map)
    os.close(fd)
    groups = [{"id": g["id"], "bytes": g["bytes"]} for g in (scan["map"] or {}).get("groups", [])]
    return {"ok": True, "at": scan["at"], "actions": [{"id": a["id"], "bytes": a["bytes"]} for a in scan["actions"]], "map": groups}


def write_scan(paths: Paths, started: float, actions: list[dict], disk_map: dict | None) -> dict:
    """Saves a scan's results, minus the actions applied since it started; without a map it keeps the last one."""
    with state_lock(paths):
        previous = read_scan(paths)
        applied = {k: v for k, v in (previous.get("appliedAt") or {}).items() if v >= started}
        actions = sorted((a for a in actions if a["id"] not in applied), key=lambda a: -a["bytes"])
        scan = {
            "schema": SCAN_SCHEMA,
            "at": round(time.time(), 1),
            "startedAt": started,
            "actions": actions,
            "map": disk_map or previous.get("map"),
            "appliedAt": applied,
        }
        write_json_atomic(paths.file("scan.json"), scan)
    return scan


def act_disk(paths: Paths, action: DiskAction, dry_run: bool, now: float, tr: Text) -> dict:
    scan = read_scan(paths)
    cached = next((a for a in scan.get("actions", []) if a.get("id") == action.id), None)
    result = {"ok": True, "id": action.id, "dryRun": dry_run}
    if cached is None:
        return {**result, "freedBytes": 0, "message": tr("act.nothing"), "items": []}
    refs = None if action.replan else [i["ref"] for i in cached["items"]]
    live = Live(paths, now, scanned_bytes={i["ref"]: i["bytes"] for i in cached["items"]})
    if dry_run:
        items = action.plan(live, within=refs)
        planned = sum(i.bytes for i in items)
        message = tr("act.would-free", count=tr.count(len(items), "item")) if items else tr("act.nothing")
        return {**result, "freedBytes": planned, "message": message, "items": [i.public() for i in items[:MAX_ITEMS]]}
    with state_lock(paths, wait=False):
        done, failed = action.apply(live, action.candidates(live) if refs is None else refs)
        freed = sum(i.bytes for i in done)
        scan = read_scan(paths) or {"schema": SCAN_SCHEMA}
        scan["actions"] = [a for a in scan.get("actions", []) if a.get("id") != action.id]
        scan.setdefault("appliedAt", {})[action.id] = now
        write_json_atomic(paths.file("scan.json"), scan)
        if not done and not failed:
            message = tr("act.nothing")
        else:
            message = tr("act.freed", count=tr.count(len(done), "item"))
            if failed:
                message = tr("act.failed", freed=message, count=tr.count(failed, "failed"))
        shown = [i.public() for i in done[:MAX_ITEMS]]
        audit(paths, {"id": action.id, "count": len(done), "items": shown, "freedBytes": freed, "result": message})
    return {**result, "freedBytes": freed, "message": message, "items": shown}


def pidfd_for(pid: int, start: int) -> int | None:
    """A pidfd for `pid` only while it is still the process that started at `start`, so later signals cannot hit a reused PID."""
    try:
        fd = os.pidfd_open(pid)
    except OSError:
        return None
    p = read_proc("/proc", pid)
    if p is None or p.start != start:
        os.close(fd)
        return None
    return fd


def send(fd: int, sig: int) -> None:
    try:
        signal.pidfd_send_signal(fd, sig)
    except ProcessLookupError:
        pass


def wait_gone(fd: int, secs: float) -> bool:
    poller = select.poll()
    poller.register(fd, select.POLLIN)
    return bool(poller.poll(int(secs * 1000)))


def end_tree(pid: int, start: int, rest: list[tuple[int, int]], last_check: Callable[[], None] | None = None) -> bool:
    """Ends `pid` while it is still the process that started at `start`: SIGTERM through a pidfd, 10 s, SIGKILL. Then
    SIGTERM to each snapshotted descendant (pid, start) still alive as the same process. Never by name. `last_check`
    runs once the pidfd pins the process and may refuse by raising Fail. False when `pid` was already gone."""
    fd = pidfd_for(pid, start)
    if fd is None:
        return False
    try:
        if last_check:
            last_check()
        send(fd, signal.SIGTERM)
        if not wait_gone(fd, 10):
            send(fd, signal.SIGKILL)
            wait_gone(fd, 5)
    finally:
        os.close(fd)
    for q, q_start in rest:
        child = pidfd_for(q, q_start)
        if child is not None:
            send(child, signal.SIGTERM)
            os.close(child)
    return True


def tree_items(procs: dict[int, Proc], tree: list[int]) -> list[dict]:
    return [{"label": f"{procs[q].comm} {q}", "bytes": procs[q].mem or 0} for q in tree]


def note_closed(session: Session, view: dict, now: float) -> None:
    """Appends the resume line to the worker's $CLAUDE_CONFIG_DIR/vpsmon-closed-sessions.md, as the worker's user: the
    folder comes from that user's environment, so root must not be the one writing there."""
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(now))
    resume = f"cd {shlex.quote(view['workspace'])} && {view['resumeCommand']}"
    line = f"- {when} · **{view['name']}** · `{resume}`\n"
    try:
        as_user(session.proc.uid, append_line, os.path.join(session.cfg, CLOSED_NOTES), line, 0o644)
    except OSError as e:
        log(f"{CLOSED_NOTES}: {e}")


def act_worker(paths: Paths, ident: str, dry_run: bool, now: float, tr: Text) -> dict:
    m = WORKER_ID_RE.fullmatch(ident)
    if not m:
        raise Fail("err.worker-id")
    pid, start = int(m.group(1)), int(m.group(2))
    procs = read_procs(paths.proc)
    p = procs.get(pid)
    if p is None or p.start != start or p.comm != "claude":
        raise Fail("err.worker-gone")
    session = next((s for s in find_sessions(procs, paths) if s.proc.pid == pid), None)
    if session is None:
        raise Fail("err.no-session")
    children = children_of(procs)
    view = worker_view(session, procs, children, now, paths.proc)
    if not view["closable"]:
        raise Fail("err.not-closable")
    tree = [pid, *descendants(children, pid)]
    items = tree_items(procs, tree)
    result = {"ok": True, "id": ident, "freedBytes": sum(i["bytes"] for i in items), "dryRun": dry_run,
              "items": items[:MAX_ITEMS]}
    result["resumeCommand"] = view["resumeCommand"]
    if dry_run:
        return {**result, "message": tr("act.would-close", name=view["name"], count=tr.count(len(tree), "process"))}
    def still_idle() -> None:
        latest = read_json(os.path.join(session.cfg, "sessions", f"{pid}.json")) or {}
        if latest.get("status") != "idle":
            raise Fail("err.became-busy")

    if not end_tree(pid, start, [(q, procs[q].start) for q in tree[1:]], still_idle):
        raise Fail("err.worker-gone")
    note_closed(session, view, now)
    message = tr("act.closed", name=view["name"])
    audit(paths, {"id": ident, "count": len(tree), "items": items[:MAX_ITEMS], "freedBytes": result["freedBytes"],
                  "result": message, "resumeCommand": f"cd {shlex.quote(view['workspace'])} && {view['resumeCommand']}"})
    return {**result, "message": message}


def act_proc(paths: Paths, ident: str, dry_run: bool, now: float, tr: Text) -> dict:
    m = PROC_ID_RE.fullmatch(ident)
    if not m:
        raise Fail("err.proc-id")
    pid, start = int(m.group(1)), int(m.group(2))
    procs = read_procs(paths.proc)
    p = procs.get(pid)
    if p is None or p.start != start:
        raise Fail("err.proc-gone")
    children = children_of(procs)
    protected = {s.proc.pid for s in find_sessions(procs, paths)} | {os.getpid()}
    if not killable(pid, procs, children, protected, lambda q: exe_of(paths.proc, q)):
        raise Fail("err.not-killable", name=p.comm)
    tree = [pid, *descendants(children, pid)]
    items = tree_items(procs, tree)
    freed = sum(i["bytes"] for i in items)
    result = {"ok": True, "id": ident, "freedBytes": freed, "dryRun": dry_run, "items": items[:MAX_ITEMS]}
    count = tr.count(len(tree), "process")
    if dry_run:
        return {**result, "message": tr("act.would-end", name=p.comm, count=count)}
    if not end_tree(pid, start, [(q, procs[q].start) for q in tree[1:]]):
        raise Fail("err.proc-gone")
    message = tr("act.ended", name=p.comm, count=count)
    audit(paths, {"id": ident, "count": len(tree), "items": items[:MAX_ITEMS], "freedBytes": freed, "result": message})
    return {**result, "message": message}


def cmd_uninstall(paths: Paths) -> dict:
    """Removes what the installer added, keeping the audit log. Rerunning removes nothing."""
    # systemctl manages only the real unit folder: under a test prefix there is nothing for it to stop.
    systemd = has_systemd() and all(os.path.dirname(u) == SYSTEMD_UNITS for u in paths.units)
    if systemd:
        for cmd in (["disable", "--now", "vpsmon-sample.timer"], ["stop", "vpsmon-scan"]):
            run(["systemctl", *cmd], ok_codes=tuple(range(256)), timeout=60)
    removed = []
    for path in (*paths.units, paths.sudoers, os.path.dirname(paths.config), paths.state, paths.bin):
        if os.path.lexists(path):
            remove_tree(path)
            removed.append(path)
    if systemd and set(paths.units) & set(removed):
        run(["systemctl", "daemon-reload"], ok_codes=tuple(range(256)), timeout=60)
    return {"ok": True, "removed": removed}


def parse_lang(argv: list[str]) -> tuple[Text, list[str]]:
    """`--lang en|es` before the command; English when it is not there."""
    if argv[:1] != ["--lang"]:
        return Text("en"), argv
    if len(argv) < 2 or argv[1] not in MESSAGES:
        raise Usage
    return Text(argv[1]), argv[2:]


def needs_root(args: list[str]) -> bool:
    """Whether the command in `args` needs root; Usage when `args` is no command."""
    match args:
        case ["version"]:
            return False
        case ["status"] | ["sample"] | ["scan"] | ["scan", "--background"] | ["uninstall"] | ["act", _] | [
            "act", _, "--dry-run"
        ]:
            return True
    raise Usage


def become_root(argv: list[str]) -> None:
    """Runs this same command again as `sudo -n <this script> <argv>`. When sudo refuses (no rule, a password needed),
    its own message reaches the app on stderr."""
    try:
        os.execvp("sudo", ["sudo", "-n", SELF, *argv])
    except FileNotFoundError:
        print("vpsmon: sudo: command not found", file=sys.stderr, flush=True)
        raise Fail("err.no-sudo") from None


def dispatch(args: list[str], paths: Paths, tr: Text) -> dict:
    now = time.time()
    match args:
        case ["version"]:
            return {"ok": True, "version": VERSION, "schema": SCHEMA}
        case ["uninstall"]:
            return cmd_uninstall(paths)
        case ["status"]:
            return cmd_status(paths, now, tr)
        case ["sample"]:
            return cmd_sample(paths, now)
        case ["scan"]:
            return cmd_scan(paths, background=False)
        case ["scan", "--background"]:
            return cmd_scan(paths, background=True)
        case ["act", ident] | ["act", ident, "--dry-run"]:
            dry_run = len(args) == 3
            if ident.startswith("worker:"):
                return act_worker(paths, ident, dry_run, now, tr)
            if ident.startswith("proc:"):
                return act_proc(paths, ident, dry_run, now, tr)
            if ident not in ACTIONS:
                raise Fail("err.unknown-action", id=ident)
            return act_disk(paths, ACTIONS[ident], dry_run, now, tr)
    raise Usage


def main() -> int:
    tr = Text("en")
    try:
        tr, args = parse_lang(sys.argv[1:])
        if needs_root(args) and os.geteuid() != 0 and not os.environ.get("VPSMON_PREFIX"):
            become_root(sys.argv[1:])
        out, code = dispatch(args, Paths.from_env(), tr), 0
    except Usage:
        out, code = {"ok": False, "error": tr("usage")}, 2
    except Fail as e:
        out, code = {"ok": False, "error": e.text(tr)}, 1
    except Exception as e:
        import traceback

        traceback.print_exc()
        out, code = {"ok": False, "error": tr("err.internal", detail=str(e))}, 1
    print(json.dumps(out, ensure_ascii=False))
    return code


if __name__ == "__main__":
    sys.exit(main())
