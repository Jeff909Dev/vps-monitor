class Text:
    """The strings of one language."""

    def __init__(self, lang: str):
        self.lang, self.messages = lang, MESSAGES[lang]

    def __call__(self, key: str, **params) -> str:
        return self.messages[key].format(**params)

    def number(self, n: int) -> str:
        return f"{n:,}".replace(",", self("num.group"))

    def count(self, n: int, noun: str) -> str:
        return self(f"noun.{noun}.{'one' if n == 1 else 'other'}", n=self.number(n))


class Fail(Exception):
    """A handled error: a message key and its params. The app shows it in --lang, as is."""

    def __init__(self, key: str, **params):
        super().__init__(key)
        self.key, self.params = key, params

    def text(self, tr: Text) -> str:
        return tr(self.key, **self.params)

    def __str__(self) -> str:
        return self.text(Text("en"))


