@dataclass(frozen=True)
class Paths:
    """Every filesystem location vpsmon reads or writes, so tests can point any of them at a temp dir."""

    state: str = "/var/lib/vpsmon"
    audit_log: str = "/var/log/vpsmon.log"
    config: str = "/etc/vpsmon/config.json"
    bin: str = "/usr/local/bin/vpsmon"
    units: tuple[str, ...] = (f"{SYSTEMD_UNITS}/vpsmon-sample.timer", f"{SYSTEMD_UNITS}/vpsmon-sample.service")
    sudoers: str = "/etc/sudoers.d/vpsmon"
    proc: str = "/proc"
    tmp: str = "/tmp"
    var_tmp: str = "/var/tmp"
    home: str = "/home"
    root_home: str = "/root"
    log_roots: tuple[str, ...] = ("/tmp", "/var/tmp", "/home", "/root", "/srv", "/opt", "/var/log")
    journal: str = "/var/log/journal"
    apt_archives: str = "/var/cache/apt/archives"

    @classmethod
    def under(cls, prefix: str) -> Paths:
        """vpsmon's own files under `prefix`, the watched host as is."""
        own = ("state", "audit_log", "config", "bin", "sudoers")
        return cls(**{f: prefix + getattr(cls, f) for f in own}, units=tuple(prefix + u for u in cls.units))

    @classmethod
    def from_env(cls) -> Paths:
        prefix = os.environ.get("VPSMON_PREFIX", "")
        return cls.under(prefix) if prefix else cls()

    def file(self, name: str) -> str:
        return os.path.join(self.state, name)

    def homes(self) -> list[str]:
        """/home/* and /root: the homes whose Claude Code versions and package caches the disk actions look at."""
        homes = [os.path.join(self.home, n) for n in listdir(self.home)] + [self.root_home]
        return [h for h in homes if is_real_dir(h)]


